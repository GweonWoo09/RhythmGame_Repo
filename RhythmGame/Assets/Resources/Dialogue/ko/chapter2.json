    { "speakerId": "Black", "screenSlot": 1, "text": "지금 알아버리면 재미없지않아?" },
    { "speakerId": "White", "screenSlot": 0, "text": "나는 조금씩이라도 알고 싶은데." },
    { "speakerId": "Black", "screenSlot": 1, "text": "…." },
    { "speakerId": "White", "screenSlot": 0, "text": "혹시 네가 알고 있는 걸 속이고 있는 거 아니야?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "음~ 그럴 리가?" },
    { "speakerId": "White", "screenSlot": 0, "text": "정말?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "응.당연하지!", "choices": [ { "text": "(검은머리가 의심스러운 것 같아. 날 속이는건가?)", "goto": "ch2_m4", "setFlags": [ "stack_confront+=5" ] }, { "text": "(왠지 이상해. 중요한 비밀같은게 숨겨져있는 건가?)", "goto": "ch2_m4", "setFlags": [ "stack_ego+=15" ] }, { "text": "(저리 당당한걸 보면 그래도 속이는건 아니겠지..좀 더 놀자)", "if": "stack_avoid>=30", "targetSequenceId": "ending_fantasy" } ] },
