    { "speakerId": "Black", "screenSlot": 1, "text": "오늘은 내가 좋아하는 곳부터 보여줄게.", "choices": [ { "text": "…알겠어.", "goto": "echo_r79", "setFlags": [ "stack_avoid+=1" ] }, { "text": "싫어.", "goto": "echo_r80", "setFlags": [ "stack_confront+=1" ] } ] },
