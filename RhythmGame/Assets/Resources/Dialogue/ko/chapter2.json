    { "speakerId": "Black", "screenSlot": 1, "text": "차라리 지금부터 새로운 걸 만드는 게 더 재미있지 않아?" },
    { "speakerId": "White", "screenSlot": 0, "text": "하지만 나는 내가 잃어버린게 궁금해." },
    { "speakerId": "Black", "screenSlot": 1, "text": "…정말?" },
    { "speakerId": "White", "screenSlot": 0, "text": "응." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그건 나중에 하자!" },
