    { "speakerId": "Black", "screenSlot": 1, "text": "복잡하게 생각할 필요가 있어?", "choices": [ { "text": "응. 당연하지", "goto": "echo_r101" }, { "text": "…없을지도 모르겠네.", "goto": "echo_r102", "setFlags": [ "stack_avoid+=5" ] } ] },
    { "id": "c326", "speakerId": "Black", "expression": "Annoyed", "screenSlot": 1, "text": "……", "goto": "ch2_m3" },
    { "id": "c328", "speakerId": "Black", "screenSlot": 1, "text": "그렇지?" },
