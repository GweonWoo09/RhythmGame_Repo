    { "speakerId": "White", "screenSlot": 0, "text": "……아침?" },
    { "speakerId": "White", "screenSlot": 0, "text": "여기에도 밤도 있고 아침도 있는 건가?" },
    { "text": "(자고 일어나니 정체불명의 담요가 덮여져 있다)" },
    { "speakerId": "White", "screenSlot": 0, "text": "……누구지?" },
