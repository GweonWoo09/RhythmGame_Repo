    { "speakerId": "White", "screenSlot": 0, "text": "……왜?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "네가 여기 온 지 얼마 안 됐잖아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "혼자 돌아다니면 재미없을걸?" },
    { "speakerId": "White", "screenSlot": 0, "text": "나는 기억을 찾아야만해." },
    { "speakerId": "Black", "screenSlot": 1, "text": "기억?" },
    { "speakerId": "White", "screenSlot": 0, "text": "응. 이 정원에 내 기억이 남아있는 거같아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "…." },
    { "speakerId": "White", "screenSlot": 0, "text": "왜 그래?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "아니야." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그냥… 네가 여기서 나랑 노는 게 더 좋을 것 같아서." },
    { "speakerId": "White", "screenSlot": 0, "text": "나는 기억을 찾아야 해." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그럼 찾으면 되지!" },
    { "speakerId": "Black", "screenSlot": 1, "text": "대신 오늘은 나랑 같이 놀자." },
    { "speakerId": "White", "screenSlot": 0, "style": "thought", "text": "(…정말 이상한 사람이네.)" },
    { "speakerId": "Black", "screenSlot": 1, "text": "그래서 싫어?", "choices": [ { "text": "응", "goto": "echo_r41" }, { "text": "아니", "goto": "c267_no" } ] },
    { "id": "c267_yes", "speakerId": "Black", "expression": "Annoyed", "screenSlot": 1, "text": "(....)", "goto": "ch2_m1" },
