    { "speakerId": "Black", "screenSlot": 1, "text": "글쎄? 난 기억 안 나는데." },
    { "speakerId": "White", "screenSlot": 0, "text": "분명히 어제 널 봤어." },
    { "speakerId": "Black", "screenSlot": 1, "text": "정말?" },
    { "speakerId": "White", "screenSlot": 0, "text": "검은 머리카락이 보였고… 나를 보고 도망갔잖아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "아하." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그럼 너는 날봤으면서 잡진않았다는 거네?" },
    { "speakerId": "White", "screenSlot": 0, "text": "…맞아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그럼 내가 이긴 거네!" },
    { "speakerId": "White", "screenSlot": 0, "text": "…무슨 말이야?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "잡히지 않았으니까!" },
    { "speakerId": "White", "screenSlot": 0, "text": "…넌 대체 뭐 하는 사람이야?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "음… 그건 비밀!" },
