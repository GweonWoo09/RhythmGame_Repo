    { "speakerId": "White", "screenSlot": 0, "text": "응. 아주 오래전에 들었던 것 같은데..." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그럼 같이 불러 볼래?" },
    { "speakerId": "White", "screenSlot": 0, "text": "가사가 기억나지 않아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "가사는 필요 없어." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그냥 네가 기억나는 만큼만 따라 하면 돼." },
