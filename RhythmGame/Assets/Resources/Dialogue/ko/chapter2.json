    { "speakerId": "White", "screenSlot": 0, "text": "……!?!" },
    { "speakerId": "Black", "screenSlot": 1, "text": "안녕!" },
    { "speakerId": "White", "screenSlot": 0, "text": "넌..어제 봤던 사람?" },
