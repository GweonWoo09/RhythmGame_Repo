  "lines": [
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…끝났다." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "이상해. 처음 연주한 곡인데도 익숙한 느낌이야." },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "마치 오래전부터 알고 있었던 것처럼…" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…어? 아까는 없었던 길인데." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "음악을 연주하고 나니까 새로운 길이 생겼어." },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "설마… 저 음악이 이 정원에 무언가를 바꾼 건가?" },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "일단 가보자." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "이곳은… 중앙 정원인가?" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "꽃이 정말 많네." },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "그런데 이상하다. 이 꽃을 보고 있자니 왜인지 따뜻하게 느껴져." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…이 꽃을 본 적이 있었던 걸까?" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "아까 만났던 그 사람일까…?" },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "…잠깐. 저건… 악보?" },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "왜 이런 곳에 악보가 떨어져 있지?" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…제목이 없네." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "혹시 모르니 챙겨 두도록 하자." },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "악보에 적힌 곡을 연주하면 방금처럼 또 다른 길이 나타나려나?" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "그렇다면 이 정원에는 이런 악보가 더 있을지도 모르겠네." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "여기는 아까보다 조금 어두운 것 같아." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "같은 정원인데도… 분위기가 전혀 다르네." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "들어가면 안 될 것 같은 기분이 들어.", "choices": [ { "text": "하지만… 한번 들어가 볼까?", "goto": "ch1_musicroom", "setFlags": [ "ch1_eager=1" ] }, { "text": "아직 들어가지 말자.", "goto": "ch1_sound", "setFlags": [ "ch1_eager=0" ] } ] },
    { "id": "ch1_musicroom", "if": "ch1_eager==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "저 안에 뭐가 있는지 확인하고 싶어." },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "이곳에 관한 정보와 관련되어 있을지도 모르잖아." },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…좋아. 조금만 들어가 보자." },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "안으로 들어와 보니 조금 알 것 같아." },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "정원이랑 이어져 있던 음악실 같은데." },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "어라? 책장에 악보가 잔뜩 있네." },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "분명 아무것도 적혀 있지 않은데, 왜 이런 악보를 여기에 모아둔 거지?" },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "혹시 아직 기록되지 않은 걸까?" },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…일단 이건 챙겨 두자." },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Surprised", "screenSlot": 0, "text": "…응? 방금 책장 뒤에서 무슨 소리가 난 것 같은데." },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…아무것도 없네. 착각이었나?" },
    { "if": "ch1_eager==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…일단 밖으로 나가자." },
    { "id": "ch1_sound", "if": "ch1_eager==0", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "굳이 위험해 보이는 곳까지 들어갈 필요는 없겠지." },
    { "if": "ch1_eager==0", "speakerId": "White", "expression": "Surprised", "screenSlot": 0, "text": "…어? 방금 누가 연주하는 소리가 들린 것 같은데." },
    { "if": "ch1_eager==0", "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "바이올린? 저쪽에서 들린 것 같아." },
    { "if": "ch1_eager==0", "speakerId": "White", "expression": "Surprised", "screenSlot": 0, "text": "…악보를 다시 한번 살펴볼까?", "choices": [ { "text": "악보를 자세히 살펴본다.", "if": "ch1_eager==0", "goto": "ch1_read", "setFlags": [ "ch1_read=1" ] }, { "text": "일단 가방에 넣어 둔다.", "if": "ch1_eager==0", "goto": "ch1_keep", "setFlags": [ "ch1_read=0" ] } ] },
    { "id": "ch1_read", "if": "ch1_read==1", "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "여기, 작은 글씨가 적혀 있어. …‘다시 연주하자’?" },
    { "if": "ch1_read==1", "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "누구랑…?" },
    { "id": "ch1_keep", "if": "ch1_read==0", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "지금은 더 알아낼 수 있는 게 없어 보여." },
    { "if": "ch1_read==0", "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "나중에 다시 확인해 보면 되겠지." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "그런데 그냥 돌아가기에는 조금 찜찜하네." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "분명 누군가 연주하는 소리를 들었는데." },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "일단 이곳을 기억해 두자." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "다시 처음 왔던 곳으로 돌아왔네." },
    { "speakerId": "White", "expression": "Happy", "screenSlot": 0, "text": "…이 꽃들을 보고 있으면 괜히 웃고 싶어져." },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "혹시 내가 예전에 이런 곳에서 지냈던 걸까?" },
    { "speakerId": "White", "expression": "Surprised", "screenSlot": 0, "text": "저 꽃 옆에 뭔가 떨어져 있어. 또 악보인가?" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…이번에는 제목이 적혀 있네." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "그런데 왜 읽으려고 하니까 머리가 조금 아픈 것 같지?" },
    { "speakerId": "White", "expression": "Surprised", "screenSlot": 0, "text": "방금… 누군가 웃고 있었어." },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "어린아이의 목소리…? 누구지?" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…역시 잘 모르겠어." },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "이 정원에 있는 것들은 전부 나와 관련되어 있어." },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "잊어버린 기억도, 이 정원의 정체도 알아내야 해." },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "정원은 생각보다 훨씬 넓은데… 어디부터 찾아야 하지?" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "음악을 따라가면 되는 걸까?" },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "그렇다면 악보가 있는 곳을 찾아보는 게 좋겠네." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…저쪽에 길이 하나 더 있어." },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "온실인가?" },
    { "speakerId": "White", "expression": "Doubt", "screenSlot": 0, "text": "그런데 왜 이렇게 조용하지? 바람 소리조차 들리지 않아." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…조용한 건 싫은데." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "저쪽엔 의자가 하나 있네. …의자 옆에 악기가 있어." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "이건… 작은 오르골이네." },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "오르골이 망가져 있어…" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "바이올린을 연주하면 고쳐질까?", "choices": [ { "text": "오르골을 고친다.", "goto": "ch1_musicbox_fix", "setFlags": [ "ch1_musicbox=1" ] }, { "text": "고치지 않고 둔다.", "goto": "ch1_musicbox_leave", "setFlags": [ "ch1_musicbox=0" ] } ] },
    { "id": "ch1_musicbox_fix", "if": "ch1_musicbox==1", "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "…그럼 한번 해보자." },
    { "if": "ch1_musicbox==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "누군가와 함께 이 음악을 들었던 것 같은데… 얼굴이 보이지 않아." },
    { "if": "ch1_musicbox==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "하지만… 이상하게 그 사람이 그리워." },
    { "if": "ch1_musicbox==1", "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "더 생각하면 안 될 것 같아. …그만." },
    { "id": "ch1_musicbox_leave", "speakerId": "White", "expression": "Surprised", "screenSlot": 0, "text": "방금… 누군가 있던 것 같은데." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…누구세요? 혹시 전에 그분인가요?" },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "분명 이 정원에는 그 사람과 나 말고 다른 사람이 있어." },
    { "speakerId": "White", "expression": "Surprised", "screenSlot": 0, "text": "방금 검은 머리카락이 보였어." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "왜 도망간 거지? 혹시 내가 무언가를 찾는 걸 알고 있는 걸까?" },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "지금은 조금 피곤해. …잠깐 쉬자." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "여기가 꿈이라면 언제 깨어날지도 모르는데… 지금 당장 깨어나고 싶지는 않아." },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "내일은 저 사람을 꼭 찾아야겠다." },
    { "speakerId": "White", "expression": "Determined", "screenSlot": 0, "text": "그리고 이 정원이 나에게 무엇을 보여주려는지도 알아낼 거야." },
    { "speakerId": "White", "expression": "Natural", "screenSlot": 0, "text": "…잘 자." }
  ]
}
