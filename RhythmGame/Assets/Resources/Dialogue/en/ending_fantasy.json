  "lines": [
    { "speakerId": "Black", "screenSlot": 1, "text": "그럼 믿어주는 거야?" },
    { "speakerId": "White", "screenSlot": 0, "text": "응." },
    { "speakerId": "White", "screenSlot": 0, "text": "적어도 지금은 그렇게 생각할래." },
    { "speakerId": "Black", "screenSlot": 1, "text": "다행이다!" },
    { "speakerId": "Black", "screenSlot": 1, "text": "괜히 의심받고 싶지는 않았거든." },
    { "speakerId": "White", "screenSlot": 0, "text": "미안. 계속 이상한 질문만 했네." },
    { "speakerId": "Black", "screenSlot": 1, "text": "괜찮아!" },
    { "speakerId": "Black", "screenSlot": 1, "text": "그만큼 네가 기억을 찾고 싶었다는 거잖아." },
    { "speakerId": "White", "screenSlot": 0, "text": "……응." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그런데 있잖아." },
    { "speakerId": "White", "screenSlot": 0, "text": "응?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "꼭 지금 당장 찾을 필요는 없지 않을까?" },
    { "speakerId": "White", "screenSlot": 0, "text": "…." },
    { "speakerId": "Black", "screenSlot": 1, "text": "기억은 도망가지 않으니까." },
    { "speakerId": "White", "screenSlot": 0, "text": "정말 그럴까?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "응. 그러니까 오늘은 그냥 쉬어도 돼." },
    { "speakerId": "White", "screenSlot": 0, "text": "…." },
    { "speakerId": "White", "screenSlot": 0, "text": "생각해보면 나도 너무 서둘렀던 것 같아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그렇지?" },
    { "speakerId": "White", "screenSlot": 0, "text": "눈을 뜨자마자 아무것도 기억하지 못한다는 걸 알았고…." },
    { "speakerId": "White", "screenSlot": 0, "text": "그래서 무조건 찾아야 한다고 생각했어." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그런데?" },
    { "speakerId": "White", "screenSlot": 0, "text": "조금 피곤한 것 같아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그럼 쉬자!" },
    { "speakerId": "White", "screenSlot": 0, "text": "…그래." },
    { "speakerId": "Black", "screenSlot": 1, "text": "오늘은 아무것도 찾지 말고." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그냥 나랑 놀자.", "choices": [ { "text": "싫어.", "goto": "echo_r30" }, { "text": "응", "goto": "echo_r31" } ] },
    { "id": "fa_no", "speakerId": "Black", "screenSlot": 1, "text": "약속?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "..약속?" },
    { "speakerId": "White", "screenSlot": 0, "text": "…" },
    { "speakerId": "Black", "screenSlot": 1, "text": "응?" },
    { "speakerId": "White", "screenSlot": 0, "text": "…" },
    { "speakerId": "White", "screenSlot": 0, "text": "...약속.", "goto": "fa_m1" },
    { "id": "fa_yes", "speakerId": "Black", "screenSlot": 1, "text": "약속?" },
    { "speakerId": "White", "screenSlot": 0, "text": "약속." },
    { "id": "fa_m1", "text": "(주인공이 주변을 바라본다.)" },
    { "speakerId": "White", "screenSlot": 0, "text": "…그런데 이상하네." },
    { "speakerId": "Black", "screenSlot": 1, "text": "뭐가?" },
    { "speakerId": "White", "screenSlot": 0, "text": "아까까지만 해도 여기 조금 망가져 있었던 것 같은데." },
    { "speakerId": "Black", "screenSlot": 1, "text": "정말?" },
    { "speakerId": "White", "screenSlot": 0, "text": "응. 분명 저쪽에." },
    { "speakerId": "Black", "screenSlot": 1, "text": "아마 네가 잘못 본 거겠지." },
    { "speakerId": "White", "screenSlot": 0, "text": "…그런가?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "응." },
    { "speakerId": "White", "screenSlot": 0, "text": "…그럼 그런가 보다." },
    { "text": "(주인공이 더 이상 주변을 살펴보지 않는다.)" },
    { "speakerId": "Black", "screenSlot": 1, "text": "있잖아." },
    { "speakerId": "White", "screenSlot": 0, "text": "응?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "아까 그 노래, 한 번 더 해볼래?" },
    { "speakerId": "White", "screenSlot": 0, "text": "그 노래?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "응." },
    { "speakerId": "White", "screenSlot": 0, "text": "…좋아." },
    { "text": "(두 사람이 다시 악기를 연주한다.)", "commands": [ "play:ch2_song_02" ] },
    { "text": "(연주가 시작되자 주변의 깨져 있던 풍경이 서서히 원래 모습으로 돌아온다.)" },
    { "speakerId": "White", "screenSlot": 0, "text": "…예쁘다." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그렇지?" },
    { "speakerId": "White", "screenSlot": 0, "text": "이렇게 평화롭게 음악을 듣고 있으니까." },
    { "speakerId": "White", "screenSlot": 0, "text": "아무것도 기억하지 않아도 괜찮을 것 같은 기분이 들어." },
    { "speakerId": "Black", "screenSlot": 1, "text": "응." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그렇게 생각해도 돼." },
    { "speakerId": "White", "screenSlot": 0, "text": "…." },
    { "speakerId": "Black", "screenSlot": 1, "text": "네가 기억하고 싶지 않은 건 기억하지 않아도 돼." },
    { "speakerId": "White", "screenSlot": 0, "text": "……기억하고 싶지 않은 것?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "……." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그냥 해본 말이야~" },
    { "speakerId": "White", "screenSlot": 0, "text": "…그렇구나." },
    { "speakerId": "Black", "screenSlot": 1, "text": "오늘은 좋은 것만 생각하자." },
    { "speakerId": "White", "screenSlot": 0, "text": "응." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그리고 내일도." },
    { "speakerId": "White", "screenSlot": 0, "text": "내일도?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "내일도 나랑 놀자." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그다음 날도." },
    { "speakerId": "Black", "screenSlot": 1, "text": "..그다음 날도." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그 그다음 날도." },
    { "speakerId": "Black", "screenSlot": 1, "text": "또 다시 그다음 날도." },
    { "speakerId": "Black", "screenSlot": 1, "text": "영원히 나랑 놀자?" },
    { "speakerId": "White", "screenSlot": 0, "text": "…." },
    { "text": "(멀리서 희미하게 문이 닫히는 소리가 들린다.)" },
    { "speakerId": "White", "screenSlot": 0, "text": "방금 무슨 소리였어?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "무슨 소리?" },
    { "speakerId": "White", "screenSlot": 0, "text": "…?" },
    { "speakerId": "White", "screenSlot": 0, "text": "됐어, 별일 아니겠지.." },
    { "text": "(주인공은 더 이상 소리가 난 방향을 바라보지 않는다.)" },
    { "speakerId": "Black", "screenSlot": 1, "text": "좋아 ♪" },
    { "speakerId": "White", "screenSlot": 0, "text": "응?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "아무것도 아니야!" },
    { "speakerId": "White", "screenSlot": 0, "text": "넌 정말 이상한 사람인 거 같아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그런데 싫지는 않잖아?" },
    { "speakerId": "White", "screenSlot": 0, "text": "...싫지는 않아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그럼 됐어!" },
    { "text": "(주인공이 웃는다.)" },
    { "speakerId": "White", "expression": "Happy", "screenSlot": 0, "text": "…이곳에 조금 더 있어도 괜찮을 것 같아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "정말?" },
    { "speakerId": "White", "screenSlot": 0, "text": "응." },
    { "speakerId": "White", "screenSlot": 0, "text": "기억을 찾는 건…조금만 나중에 해도 되겠지." },
    { "speakerId": "Black", "screenSlot": 1, "text": "아주 나중에 해도 돼." },
    { "text": "(두 사람의 음악이 정원 전체에 울려 퍼진다.)" },
    { "text": "(멀리 있던 길 하나가 조용히 사라진다.)" },
    { "speakerId": "White", "screenSlot": 0, "text": "…?" },
    { "speakerId": "White", "screenSlot": 0, "text": "방금 길이..." },
    { "speakerId": "Black", "screenSlot": 1, "text": "왜?" },
    { "speakerId": "White", "screenSlot": 0, "text": "…아니야." },
    { "speakerId": "White", "screenSlot": 0, "text": "내가 잘못 본 것 같아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "그렇지?" },
    { "speakerId": "White", "screenSlot": 0, "text": "응." },
    { "speakerId": "White", "screenSlot": 0, "text": "오늘은 그냥..조금만 더 쉬자, 피곤한거 같아." },
    { "speakerId": "Black", "screenSlot": 1, "text": "응!" },
    { "text": "(주인공은 더 이상 사라진 길을 찾지 않는다.)" },
    { "text": "(그리고 그날 이후, 주인공은 자신이 잃어버린 기억을 찾는 일을 잠시 잊기 시작했다.)" },
    { "speakerId": "White", "screenSlot": 0, "style": "thought", "text": "(..분명 이곳 생활이 즐겁지만 왠지 찝찝해)" },
    { "speakerId": "Black", "screenSlot": 1, "text": "뭘 그리 생각해? 어서 놀러가자!" },
    { "text": "(다음 날)", "commands": [ "hide:right" ] },
    { "speakerId": "White", "screenSlot": 0, "text": "……또 아침이네." },
    { "speakerId": "White", "screenSlot": 0, "text": "이곳에서는 시간이 어떻게 흐르는 걸까?" },
    { "speakerId": "White", "screenSlot": 0, "text": "잠들었다가 눈을 뜨면 아침이 되어 있고……." },
    { "speakerId": "White", "screenSlot": 0, "text": "어제와 똑같은 하루가 시작되는 것 같아." },
    { "speakerId": "White", "screenSlot": 0, "text": "……그런데." },
    { "speakerId": "White", "screenSlot": 0, "text": "뭔가 달라진 것 같은데?" },
    { "text": "(주인공이 주변을 둘러본다.)" },
    { "speakerId": "White", "screenSlot": 0, "text": "……어제 봤던 길이 없어졌어." },
    { "speakerId": "White", "screenSlot": 0, "text": "분명 저쪽으로 이어져 있었는데." },
    { "speakerId": "White", "screenSlot": 0, "text": "설마……." },
    { "speakerId": "White", "screenSlot": 0, "text": "내가 어제 본 게 정말 잘못 본 게 아니었던 걸까?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "일어났어?", "commands": [ "show:right" ] },
    { "speakerId": "White", "screenSlot": 0, "text": "……!" },
    { "speakerId": "Black", "screenSlot": 1, "text": "왜 그렇게 놀라?" },
    { "speakerId": "White", "screenSlot": 0, "text": "아니…… 그냥." },
    { "speakerId": "White", "screenSlot": 0, "text": "너는 언제부터 여기 있었어?" },
    { "speakerId": "Black", "screenSlot": 1, "text": "조금 전부터?" },
    { "speakerId": "White", "screenSlot": 0, "text": "……그렇구나." },
    { "speakerId": "Black", "screenSlot": 1, "text": "오늘도 같이 놀자!" },
    { "id": "fantasy_end", "text": "[닫힌 문 안으로 아득히 떨어지다]", "setFlags": [ "ending_fantasy=1" ], "goto": "end" },
